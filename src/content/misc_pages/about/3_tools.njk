<div class="mb-4">
    <p class="text-2xl"> My Tool Box </p>
</div>

<div class="grid grid-cols-7 gap-4">
    {% set common_config = "group mb-4 p-4 rounded-lg shadow-lg bg-zinc-50 
                            hover:bg-zinc-200 dark:bg-slate-700 hover:dark:bg-slate-500 
                            flex items-center justify-center text-center 
                            whitespace-normal relative cursor-pointer transition-all" %}
    {% for tool in tool_box.tools %}
        <div class="{{common_config}}">
            <span class="group-hover:hidden">{{ tool.name }}</span>
            {% icon tool.icon_slug, class="hidden group-hover:block w-8 h-8 md:w-10 md:h-10 lg:w-12 lg:h-12 fill-current text-black dark:text-white" %}
        </div>
    {% endfor %}
</div>